            "path": "/repos/{owner}/{repo}/actions/runs/{run_id}/rerun-failed-jobs",
            "safety": "write"
          },
          {
            "method": "POST",
            "path": "/repos/{owner}/{repo}/pulls",
            "safety": "write"
          },
          {
            "method": "PUT",
            "path": "/repos/{owner}/{repo}/pulls/{number}/update-branch",
            "safety": "write"
          },
          {
            "method": "POST",
            "path": "/graphql",
            "safety": "write"
          },
          {
            "method": "PUT",
            "path": "/repos/{owner}/{repo}/pulls/{number}/merge",
            "safety": "destructive"
          },
          {
            "method": "PATCH",
            "path": "/repos/{owner}/{repo}/pulls/{number}",
            "safety": "destructive"
          },
          {
            "method": "DELETE",
            "path": "/repos/{owner}/{repo}/git/refs/heads/{branch}",
            "safety": "destructive"
          }
        ]
      }
