  "events": "schemas/events.json",
  "uiActions": "schemas/ui-actions.json",
  "idempotentTools": [
    "get_check_output",
    "get_checks",
    "get_compare",
    "get_mergeability",
    "get_pull_request",
    "get_pull_request_diff",
    "get_pull_request_files",
    "get_pull_request_summary",
    "get_status",
    "list_accounts",
    "list_assignees",
    "list_branches",
    "list_comments",
    "list_commits",
    "list_labels",
    "list_pull_requests",
    "list_repositories",
    "list_reviews",
    "preview_close_pull_request",
    "preview_delete_branch",
    "preview_merge_pull_request",
    "view_actions",
    "view_changes",
    "view_state"
