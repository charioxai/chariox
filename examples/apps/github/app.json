            "path": "/repos/{owner}/{repo}/pulls/{number}/reviews",
            "safety": "write"
          },
          {
            "method": "POST",
            "path": "/repos/{owner}/{repo}/issues/{number}/labels",
            "safety": "write"
          },
          {
            "method": "DELETE",
            "path": "/repos/{owner}/{repo}/issues/{number}/labels/{name}",
            "safety": "write"
          },
          {
            "method": "POST",
            "path": "/repos/{owner}/{repo}/pulls/{number}/requested_reviewers",
            "safety": "write"
          },
          {
            "method": "DELETE",
            "path": "/repos/{owner}/{repo}/pulls/{number}/requested_reviewers",
            "safety": "write"
          },
          {
