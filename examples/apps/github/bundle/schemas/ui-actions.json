{
  "uiActions": [
    {
      "name": "list_accounts",
      "description": "The GitHub accounts this App uses: label, login, status and API rate limit. Accounts are bound by the owner in the kernel; this lists the ones the App knows.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "add_account",
      "description": "Make the App use a GitHub account the owner bound in the kernel (label as bound). The App checks it by reading its user.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          }
        },
        "required": [
          "account"
        ]
      }
    },
    {
      "name": "remove_account",
      "description": "Stop using an account in this App. The owner's binding in the kernel is not changed.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          }
        },
        "required": [
          "account"
        ]
      }
    },
    {
      "name": "set_default_account",
      "description": "Use this account when a call names none.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          }
        },
        "required": [
          "account"
        ]
      }
    },
    {
      "name": "set_repo_account",
      "description": "Use this account for one repository, or the default again when account is absent.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$",
            "description": "owner/name"
          },
          "account": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          }
        },
        "required": [
          "repo"
        ]
      }
    },
    {
      "name": "get_status",
      "description": "API rate limits of the accounts (core and search) and which accounts work.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$",
            "description": "The account to use; the default account when absent."
          }
        }
      }
    },
    {
      "name": "list_repositories",
      "description": "Repositories the account can see, most recently pushed first.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$",
            "description": "The account to use; the default account when absent."
          },
          "org": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$"
          },
          "query": {
            "type": "string",
            "maxLength": 100
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    {
      "name": "list_pull_requests",
      "description": "Pull requests: created by the account (mine), waiting for its review (review_requested), in repositories (repo), in an organization (org) or involving the account (all).",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$",
            "description": "The account to use; the default account when absent."
          },
          "scope": {
            "enum": [
              "mine",
              "review_requested",
              "repo",
              "org",
              "all"
            ]
          },
          "repos": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$",
              "description": "owner/name"
            }
          },
          "org": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$"
          },
          "state": {
            "enum": [
              "open",
              "closed",
              "merged",
              "all"
            ]
          },
          "draft": {
            "enum": [
              "any",
              "only",
              "hide"
            ]
          },
          "labels": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "author": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}$"
          },
          "review": {
            "enum": [
              "approved",
              "changes_requested",
              "required",
              "none"
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "scope"
        ]
      }
    },
    {
      "name": "get_pull_request",
