            "description": "owner/name"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "path": {
            "type": "string",
            "maxLength": 1024
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 1048576
          }
        },
        "required": [
          "repo",
          "number"
        ]
      }
    },
