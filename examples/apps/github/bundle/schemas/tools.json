          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "repo",
          "number"
        ]
      }
    },
    {
      "name": "get_pull_request_diff",
      "description": "The unified diff of a pull request, or of one file, at most maxBytes (default 262144).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string",
