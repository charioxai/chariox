{
  "tools": [
    {
      "name": "get_automations",
      "description": "Read the outgoing event to automation names setting.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "configure_automations",
      "description": "Replace the outgoing event to automation names setting. Configure each named automation in the kernel first. An empty list explicitly disables forwarding for that event.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "automations"
        ],
        "properties": {
          "automations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pull_request_opened_notification": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "pull_request_updated_notification": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "review_requested_notification": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "issue_opened_notification": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "workflow_run_completed_notification": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        }
      }
    }
  ]
}
