{
  "uiActions": [
    {
      "name": "list_documents",
      "description": "List documents, optionally only those in one folder.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "effect": "read"
    },
    {
      "name": "read_document",
      "description": "Read a document's content, optionally at an earlier revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "effect": "read"
    },
    {
      "name": "create_document",
      "description": "Create a Markdown or HTML document.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "markdown",
              "html"
            ]
          },
          "folder": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "maxLength": 524288
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "effect": "write"
    },
    {
      "name": "update_document",
      "description": "Change a document's content, title or folder. expected_revision must be the revision you read; a newer revision is a conflict to resolve by re-reading.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string",
            "maxLength": 524288
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "folder": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "expected_revision"
        ],
        "additionalProperties": false
      },
      "effect": "write"
    },
    {
      "name": "restore_version",
      "description": "Restore an earlier revision's content as the newest revision. Title and folder are not restored, so a rename or move revision restores nothing visible.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "revision",
          "expected_revision"
        ],
        "additionalProperties": false
      },
      "effect": "write"
    },
    {
      "name": "delete_document",
      "description": "Delete a document and its history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "effect": "approval",
      "approvalReason": "Deleting a document also deletes its history and cannot be undone."
    },
    {
      "name": "import_documents",
      "description": "Ask the owner to choose Markdown, HTML or text files to import as new documents. Waits up to 20 seconds for the owner's choice in their prompt, then returns the new documents and any file that could not be imported. While the owner has not chosen it returns {pending: true, importId}: call again with that importId to keep waiting (the request stays open for ten minutes).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string",
            "maxLength": 200
          },
          "importId": {
            "type": "string",
            "maxLength": 128
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 255
                },
                "content": {
                  "type": "string",
                  "maxLength": 524288
                }
              },
              "required": [
                "name",
                "content"
              ],
              "additionalProperties": false
            },
            "description": "Files already read as UTF-8 text (the window passes the files its person chose); the owner is not asked."
          }
        },
        "additionalProperties": false
      },
      "effect": "write"
    },
    {
      "name": "export_document",
      "description": "Offer the owner a copy of a document to save on their computer. Returns the offered file name; the owner saves it from their prompt.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "effect": "write"
    },
    {
      "name": "snapshot_documents",
      "description": "Keep a consistent copy of every document and its history, taken by Chariox outside the App's data. Chariox keeps the newest two.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          }
        },
        "additionalProperties": false
      },
      "effect": "write"
    },
    {
      "name": "save_draft",
      "description": "Keep the person's unsaved edit of an open document, started from base_revision, so a replaced window finds it again. Replaces the earlier draft; saving the document is update_document.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "base_revision": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string",
            "maxLength": 524288
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "folder": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "base_revision"
        ],
        "additionalProperties": false
      },
      "effect": "write"
    },
    {
      "name": "read_draft",
      "description": "Read the person's unsaved edit, kept by save_draft, or null when there is none or its document was deleted.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "effect": "read"
    },
    {
      "name": "discard_draft",
      "description": "Drop the person's unsaved edit once it is saved or given up.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "effect": "write"
    }
  ]
}
