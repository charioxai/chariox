{
  "uiActions": [
    {
      "name": "workbook_summary",
      "description": "Read workbook names, used dimensions, active selection and a bounded A1 preview.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "read_range",
      "description": "Read calculated values and formulas from a bounded A1 range, at most 1000 cells.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "range": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,4}(:[A-Z]{1,2}[1-9][0-9]{0,4})?$"
          }
        },
        "required": [
          "range"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "set_range",
      "description": "Set a rectangular range. Strings starting with = are Univer formulas; other primitives are cell values.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "range": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,4}(:[A-Z]{1,2}[1-9][0-9]{0,4})?$"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "range",
          "values"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "edit_dimension",
      "description": "Insert or delete rows or columns using zero-based indices.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "axis": {
            "enum": [
              "rows",
              "columns"
            ]
          },
          "operation": {
            "enum": [
              "insert",
              "delete"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "axis",
          "operation",
          "index",
          "count"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sort_range",
      "description": "Sort an A1 range by an absolute zero-based column index; leave a header outside the range.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "range": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,4}(:[A-Z]{1,2}[1-9][0-9]{0,4})?$"
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "ascending": {
            "type": "boolean"
          }
        },
        "required": [
          "range",
          "column",
          "ascending"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "import_csv",
      "description": "Replace the open workbook from a UTF-8 CSV in App data, optionally importing a picked grant first. CSV text is literal; canonical numbers become numeric cells.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "grantId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "export_csv",
      "description": "Export calculated cell values as RFC 4180 CSV to App data, optionally offering the file to the user.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "range": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,4}(:[A-Z]{1,2}[1-9][0-9]{0,4})?$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "offer": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "save_workbook",
      "description": "Save the complete workbook and formulas with optimistic version checking.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "open_workbook",
      "description": "Replace the open workbook from a Chariox Univer JSON file in App data, optionally importing a picked grant first.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "grantId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "export_workbook",
      "description": "Export a Chariox Univer JSON workbook preserving formulas, calculated values, styles and sheet metadata.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "offer": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pick_file",
      "description": "Ask the user to select one CSV or Univer JSON file and return its import grant.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "format": {
            "enum": [
              "csv",
              "workbook"
            ]
          }
        },
        "required": [
          "format"
        ],
        "additionalProperties": false
      }
    }
  ]
}
