# MP-08 / MP-10 / MP-11: generated by lanes-kernel.mjs install-service
[Unit]
Description=Chariox lanes kernel and round service
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
Slice=lanes.slice
Environment="LANES_KERNEL_STATE=@STATE@"
ExecStart="@NODE@" "@SCRIPT@" start
ExecStop="@NODE@" "@SCRIPT@" stop
Restart=on-failure
RestartSec=15
TimeoutStartSec=600
TimeoutStopSec=180
KillMode=control-group
# One OOM-killed process must not stop the service and with it every lane (10-26 04:38Z).
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
