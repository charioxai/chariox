{
  "name": "@chariox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --workspace-root run build:kernel-client && tsc -p tsconfig.json",
    "lint": "pnpm --workspace-root run build:kernel-client && tsc -p tsconfig.json --noEmit",
    "drill:live-publication-traces": "pnpm run build && node scripts/live-publication-trace-drill.mjs",
    "test": "pnpm run build && node --test dist/index.test.js"
  },
  "dependencies": {
    "@chariox/kernel-client": "workspace:*",
    "fastify": "^5.1.0"
  },
  "bin": {
    "chariox-workflow-gateway": "dist/index.js",
    "chariox-workflow-call": "dist/workflow-call.js"
  }
}
