[Unit]
Description=Chariox dedicated Hetzner data-volume admission
After=local-fs.target
Before=chariox-slice-disk-quota-allocator.service chariox-rootless-docker.service chariox-path1-managed-bootstrap.service chariox-disposable-worker-bootstrap.service
RequiresMountsFor=/var/lib/chariox-docker/data

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/node /usr/lib/chariox/current/usr/lib/chariox/slice-build-context/apps/kernel/slice-linux-docker/chariox-data-volume-admission.mjs
TimeoutStartSec=120
StateDirectory=chariox-data-volume
StateDirectoryMode=0700
RuntimeDirectory=chariox-data-volume-observation
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
# Never list the data root: ReadWritePaths bind-mounts it, which admission would read
# as a non-XFS mount there. The XFS mount made through systemd-mount propagates in writable.
ReadWritePaths=/var/lib/chariox-data-volume /run/chariox-data-volume-observation
UMask=0077
