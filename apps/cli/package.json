{
  "name": "@arroba/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @arroba/kernel-client run build && pnpm --filter @arroba/tool-display run build && node scripts/build.mjs",
    "graph:drills": "pnpm run build && node scripts/workflow-graph-drills.mjs",
    "mcp-skill:drill": "node scripts/live-mcp-skill-drill.mjs --providers opencode,codex",
    "runtime-mcp-reattach:drill": "node scripts/live-runtime-mcp-reattach-drill.mjs --providers opencode,codex",
    "provider-context-injection:drill": "node scripts/live-provider-context-injection-drill.mjs --providers opencode,codex,claude",
    "prompt-assembly:drill": "node scripts/live-prompt-assembly-drill.mjs --providers codex,opencode,claude",
    "remote-popup:drill": "node scripts/live-remote-popup-drill.mjs --providers opencode,codex",
    "remote-skill:drill": "node scripts/live-remote-skill-drill.mjs",
    "script-extension:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-script-extension-drill.mjs",
    "script-extension-agent:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-script-extension-agent-drill.mjs",
    "connector-extension:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-connector-extension-drill.mjs",
    "connector-extension-agent:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-connector-extension-agent-drill.mjs",
    "workspace-live-sync:drill": "node scripts/live-workspace-live-sync-drill.mjs --provider codex --provider-model codex=gpt-5.2",
    "workspace-live-sync:managed-drill": "node scripts/live-workspace-live-sync-drill.mjs --provider codex --provider-model codex=gpt-5.2 --mode managed --managed-target-count 2",
    "workspace-live-sync:same-branch-tracked-drill": "node scripts/live-workspace-live-sync-drill.mjs --provider codex --provider-model codex=gpt-5.2 --mode tracked --tracked-target-count 2 --tracked-bidirectional --target-branch main --timeout-ms 700000",
    "workspace-live-sync:tracked-drill": "node scripts/live-workspace-live-sync-drill.mjs --provider codex --provider-model codex=gpt-5.2 --mode tracked --tracked-target-count 2 --tracked-bidirectional --target-branch live-sync-tracked-parity-target --timeout-ms 700000",
    "workspace-live-sync:permission-drill": "node scripts/live-workspace-live-sync-permission-drill.mjs --provider codex --provider-model codex=gpt-5.2",
    "workspace-live-sync:remote-drill": "node scripts/live-remote-workspace-live-sync-drill.mjs --provider codex --provider-model codex=gpt-5.2 --full",
    "workspace-live-sync:remote-managed-drill": "node scripts/live-remote-workspace-live-sync-drill.mjs --provider codex --provider-model codex=gpt-5.2 --mode managed --managed-target-count 2 --full",
    "workspace-live-sync:remote-tracked-drill": "node scripts/live-remote-workspace-live-sync-drill.mjs --provider codex --provider-model codex=gpt-5.2 --mode tracked --tracked-target-count 2 --tracked-bidirectional --target-branch remote-live-sync-tracked-parity-target --full --timeout-ms 700000",
    "workspace-live-sync:remote-tracked-restart-drill": "node scripts/live-remote-workspace-live-sync-drill.mjs --provider codex --provider-model codex=gpt-5.2 --mode tracked --tracked-target-count 2 --tracked-bidirectional --target-branch remote-live-sync-restart-tracked-target --full --restart-relay-before-sync --timeout-ms 700000",
    "workspace-live-sync:remote-permission-drill": "node scripts/live-remote-workspace-live-sync-permission-drill.mjs --provider codex --provider-model codex=gpt-5.2",
    "workspace-live-sync:opencode-managed-drill": "node scripts/live-workspace-live-sync-drill.mjs --provider opencode --provider-model opencode=opencode/gpt-5.2 --mode managed --managed-target-count 2 --timeout-ms 700000",
    "workspace-live-sync:opencode-same-branch-tracked-drill": "node scripts/live-workspace-live-sync-drill.mjs --provider opencode --provider-model opencode=opencode/gpt-5.2 --mode tracked --tracked-target-count 2 --tracked-bidirectional --target-branch main --timeout-ms 700000",
    "workspace-live-sync:opencode-tracked-drill": "node scripts/live-workspace-live-sync-drill.mjs --provider opencode --provider-model opencode=opencode/gpt-5.2 --mode tracked --tracked-target-count 2 --tracked-bidirectional --target-branch live-sync-opencode-tracked-parity-target --timeout-ms 700000",
    "workspace-live-sync:opencode-permission-drill": "node scripts/live-workspace-live-sync-permission-drill.mjs --provider opencode --provider-model opencode=opencode/gpt-5.2 --timeout-ms 700000",
    "workspace-live-sync:opencode-remote-managed-drill": "node scripts/live-remote-workspace-live-sync-drill.mjs --provider opencode --provider-model opencode=opencode/gpt-5.2 --mode managed --managed-target-count 2 --full --timeout-ms 700000",
    "workspace-live-sync:opencode-remote-tracked-drill": "node scripts/live-remote-workspace-live-sync-drill.mjs --provider opencode --provider-model opencode=opencode/gpt-5.2 --mode tracked --tracked-target-count 2 --tracked-bidirectional --target-branch remote-live-sync-opencode-tracked-parity-target --full --timeout-ms 700000",
    "workspace-live-sync:opencode-remote-permission-drill": "node scripts/live-remote-workspace-live-sync-permission-drill.mjs --provider opencode --provider-model opencode=opencode/gpt-5.2 --timeout-ms 700000",
    "shell:drill": "pnpm --filter @arroba/shell run build && node scripts/live-shell-scriptability-drill.mjs",
    "local-restart:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-local-restart-drill.mjs",
    "cli-restart:drill": "pnpm run build && node scripts/live-cli-kernel-restart-drill.mjs",
    "remote-restart:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-remote-restart-drill.mjs",
    "git-observation:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-git-observation-drill.mjs",
    "remote-git-observation:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-remote-git-observation-drill.mjs",
    "postgres-archive:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-postgres-archive-adapter-drill.mjs",
    "publication:drill": "pnpm --filter @arroba/server run build && pnpm --filter @arroba/kernel-client run build && node scripts/live-workflow-publication-drill.mjs",
    "publication:docker-connectors-drill": "pnpm --filter @arroba/server run build && pnpm --filter @arroba/kernel-client run build && node scripts/live-workflow-publication-docker-connectors-drill.mjs",
    "semantic-url-renderer:drill": "pnpm --filter @arroba/server run build && pnpm --filter @arroba/kernel-client run build && node scripts/live-semantic-url-renderer-drill.mjs",
    "workflow-to-workflow-publication:drill": "pnpm --filter @arroba/server run build && pnpm --filter @arroba/kernel-client run build && node scripts/live-workflow-to-workflow-publication-drill.mjs",
    "relay-identity:drill": "node scripts/live-relay-identity-security-drill.mjs",
    "cloud-relay:drill": "pnpm run build && node scripts/live-cloud-relay-drill.mjs",
    "hosted-terminal-pairing-tui:drill": "node scripts/live-hosted-terminal-pairing-tui-drill.mjs",
    "multi-user-workflow:drill": "node scripts/live-multi-user-workflow-drill.mjs",
    "multi-user-cli-workflow:drill": "pnpm run build && node scripts/live-multi-user-cli-workflow-drill.mjs",
    "multi-user-freeform-relay:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-relay-freeform-multi-user-drill.mjs",
    "outline:drills": "pnpm run build && node scripts/workflow-outline-drills.mjs",
    "lint": "pnpm --filter @arroba/kernel-client run build && pnpm --filter @arroba/tool-display run build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run lint && pnpm run build && node --test dist/*.test.js",
    "start": "bun dist/index.js",
    "dev": "pnpm run build && bun dist/index.js",
    "embedded-shell:drill": "pnpm run build && node scripts/live-embedded-shell-automation-drill.mjs",
    "tui-plan-mode:drill": "pnpm run build && node scripts/live-tui-plan-mode-drill.mjs",
    "agent-footer-status:drill": "pnpm run build && node scripts/agent-footer-status-drill.mjs",
    "native-tui:codex-drill": "pnpm run build && node scripts/live-codex-native-tui-drill.mjs",
    "native-tui:opencode-drill": "pnpm run build && node scripts/live-opencode-native-tui-drill.mjs",
    "claude-provider:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-claude-provider-drill.mjs",
    "native-tui:permission-drill": "pnpm run build && node scripts/live-native-tui-permission-drill.mjs",
    "native-tui:provider-command-drill": "pnpm run build && node scripts/live-native-tui-provider-command-drill.mjs",
    "native-tui:prompt-injection-drill": "pnpm run build && node scripts/live-native-tui-prompt-injection-drill.mjs",
    "native-tui:attachment-drill": "pnpm run build && node scripts/live-native-tui-attachment-drill.mjs",
    "native-tui:workflow-drill": "pnpm run build && node scripts/live-native-tui-workflow-drill.mjs",
    "native-tui:remote-drill": "pnpm run build && node scripts/live-remote-native-tui-drill.mjs",
    "native-tui:claude-drill": "pnpm run build && node scripts/live-claude-native-tui-drill.mjs",
    "native-tui:claude-spike": "node scripts/live-claude-native-tui-spike.mjs"
