  "dependencies": {
    "@opentui/core": "0.1.87",
    "@opentui/solid": "0.1.87",
    "qrcode-terminal": "^0.12.0",
    "solid-js": "^1.9.9",
    "ws": "^8.18.3",
    "@arroba/kernel-client": "workspace:*",
    "@arroba/tool-display": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "babel-preset-solid": "^1.9.9"
  }
