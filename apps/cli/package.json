{
  "name": "@arroba/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @arroba/kernel-client run build && pnpm --filter @arroba/tool-display run build && node scripts/build.mjs",
    "graph:drills": "pnpm run build && node scripts/workflow-graph-drills.mjs",
    "mcp-skill:drill": "node scripts/live-mcp-skill-drill.mjs --providers opencode,codex",
    "runtime-mcp-reattach:drill": "node scripts/live-runtime-mcp-reattach-drill.mjs --providers opencode,codex",
    "remote-popup:drill": "node scripts/live-remote-popup-drill.mjs --providers opencode,codex",
    "remote-skill:drill": "node scripts/live-remote-skill-drill.mjs",
    "managed-io:drill": "node scripts/live-managed-io-drill.mjs --providers opencode,codex",
    "managed-io:remote-drill": "node scripts/live-remote-managed-io-drill.mjs --providers opencode --full",
    "shell:drill": "pnpm --filter @arroba/shell run build && node scripts/live-shell-scriptability-drill.mjs",
    "local-restart:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-local-restart-drill.mjs",
    "cli-restart:drill": "pnpm run build && node scripts/live-cli-kernel-restart-drill.mjs",
    "remote-restart:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-remote-restart-drill.mjs",
    "git-observation:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-git-observation-drill.mjs",
    "remote-git-observation:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-remote-git-observation-drill.mjs",
    "postgres-archive:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-postgres-archive-adapter-drill.mjs",
    "publication:drill": "pnpm --filter @arroba/server run build && pnpm --filter @arroba/kernel-client run build && node scripts/live-workflow-publication-drill.mjs",
    "publication:docker-connectors-drill": "pnpm --filter @arroba/server run build && pnpm --filter @arroba/kernel-client run build && node scripts/live-workflow-publication-docker-connectors-drill.mjs",
    "semantic-url-renderer:drill": "pnpm --filter @arroba/server run build && pnpm --filter @arroba/kernel-client run build && node scripts/live-semantic-url-renderer-drill.mjs",
    "workflow-to-workflow-publication:drill": "pnpm --filter @arroba/server run build && pnpm --filter @arroba/kernel-client run build && node scripts/live-workflow-to-workflow-publication-drill.mjs",
    "relay-identity:drill": "node scripts/live-relay-identity-security-drill.mjs",
    "cloud-relay:drill": "pnpm run build && node scripts/live-cloud-relay-drill.mjs",
    "hosted-terminal-pairing-tui:drill": "node scripts/live-hosted-terminal-pairing-tui-drill.mjs",
    "multi-user-workflow:drill": "node scripts/live-multi-user-workflow-drill.mjs",
    "multi-user-cli-workflow:drill": "pnpm run build && node scripts/live-multi-user-cli-workflow-drill.mjs",
    "multi-user-freeform-relay:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-relay-freeform-multi-user-drill.mjs",
    "outline:drills": "pnpm run build && node scripts/workflow-outline-drills.mjs",
    "lint": "pnpm --filter @arroba/kernel-client run build && pnpm --filter @arroba/tool-display run build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run lint && pnpm run build && node --test dist/*.test.js",
    "start": "bun dist/index.js",
    "dev": "pnpm run build && bun dist/index.js",
    "embedded-shell:drill": "pnpm run build && node scripts/live-embedded-shell-automation-drill.mjs",
    "tui-plan-mode:drill": "pnpm run build && node scripts/live-tui-plan-mode-drill.mjs",
    "agent-footer-status:drill": "pnpm run build && node scripts/agent-footer-status-drill.mjs",
    "native-tui:codex-drill": "pnpm run build && node scripts/live-codex-native-tui-drill.mjs",
    "native-tui:opencode-drill": "pnpm run build && node scripts/live-opencode-native-tui-drill.mjs",
    "claude-provider:drill": "pnpm --filter @arroba/kernel-client run build && node scripts/live-claude-provider-drill.mjs",
    "native-tui:permission-drill": "pnpm run build && node scripts/live-native-tui-permission-drill.mjs",
    "native-tui:provider-command-drill": "pnpm run build && node scripts/live-native-tui-provider-command-drill.mjs",
    "native-tui:prompt-injection-drill": "pnpm run build && node scripts/live-native-tui-prompt-injection-drill.mjs",
    "native-tui:attachment-drill": "pnpm run build && node scripts/live-native-tui-attachment-drill.mjs",
    "native-tui:workflow-drill": "pnpm run build && node scripts/live-native-tui-workflow-drill.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.1.87",
    "@opentui/solid": "0.1.87",
    "qrcode-terminal": "^0.12.0",
    "solid-js": "^1.9.9",
    "ws": "^8.18.3",
    "@arroba/kernel-client": "workspace:*",
    "@arroba/tool-display": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "babel-preset-solid": "^1.9.9"
  }
}
