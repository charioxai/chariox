{
  "actions": [
    {
      "name": "send_greeting",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": { "message": { "type": "string", "maxLength": 200 } }
      },
      "criticalValidation": { "reason": "Posts the greeting to an external echo service", "userVerification": false },
      "effectRoutes": [{ "origin": "https://httpbin.org", "method": "POST", "path": "/post", "connection": "echo" }]
    }
  ]
}
