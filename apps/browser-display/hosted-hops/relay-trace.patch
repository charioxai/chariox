+
+// MP-08/MP-10/MP-11 observer: fixed stages + numeric event ID/time only.
+fn vidlat_enabled() -> bool {
+    static YES: OnceLock<bool> = OnceLock::new();
+    *YES.get_or_init(|| std::env::var_os("VIDLAT_RELAY_TIMING").is_some())
+}
+fn vidlat_event_id(message: &Message) -> Option<u64> {
+    if !vidlat_enabled() { return None; }
+    // Only the existing bounded, clear routing header is parsed; ciphertext untouched.
+    match message {
+        Message::Binary(bytes) => crate::binary_event::decode(bytes).ok().map(|(h, _)| h.event_id),
+        _ => None,
+    }
+}
+fn vidlat_trace(stage: &'static str, event_id: u64) {
+    use std::io::Write;
+    if !vidlat_enabled() { return; }
+    static LOGGER: OnceLock<Option<std::sync::mpsc::SyncSender<String>>> = OnceLock::new();
+    let logger = LOGGER.get_or_init(|| {
+        let path = std::env::var("VIDLAT_RELAY_TIMING").ok()?;
+        if !path.starts_with("/root/.chariox/dev/vidlat/r6/") && !path.starts_with("/w/valenv/prs/pr965-vidlatr6/trace/") { return None; }
+        let file = std::fs::OpenOptions::new().create(true).append(true).open(path).ok()?;
+        let (tx, rx) = std::sync::mpsc::sync_channel::<String>(4096);
+        std::thread::spawn(move || {
+            let mut out = std::io::BufWriter::new(file);
+            loop {
+                match rx.recv_timeout(std::time::Duration::from_millis(100)) {
+                    Ok(row) => { let _ = writeln!(out, "{}", row); },
+                    Err(std::sync::mpsc::RecvTimeoutError::Timeout) => { let _ = out.flush(); },
+                    Err(_) => break,
+                }
+            }
+            let _ = out.flush();
+        });
+        Some(tx)
+    });
+    if let Some(tx) = logger {
+        let at = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_secs_f64()*1000.0;
+        let _ = tx.try_send(format!("{{\"stage\":\"{}\",\"event_id\":{},\"at_ms\":{}}}", stage, event_id, at));
+    }
+}
