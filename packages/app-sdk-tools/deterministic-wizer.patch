+// Build snapshots must not capture host entropy or the builder's clock. This
+// affects Wizer only; the installed component still imports runtime randomness.
+struct SnapshotClock;
+impl wasmtime_wasi::clocks::HostWallClock for SnapshotClock {
+    fn resolution(&self) -> std::time::Duration { std::time::Duration::from_millis(1) }
+    fn now(&self) -> std::time::Duration { std::time::Duration::ZERO }
+}
+impl wasmtime_wasi::clocks::HostMonotonicClock for SnapshotClock {
+    fn resolution(&self) -> u64 { 1 }
+    fn now(&self) -> u64 { 0 }
+}
