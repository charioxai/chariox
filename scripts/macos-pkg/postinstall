#!/bin/bash
# Install the kernel, its WASM App worker, slice context and boot admission locks.
set -euo pipefail
umask 022
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# Empty in the package. Tests render this script with a fake root under which
# every host path, including the launchctl it drives, resolves.
R='@@ROOT@@'
VERSION='@@VERSION@@'
LABEL=dev.chariox.kernel
SUPPORT="$R/Library/Application Support/Chariox"
PACKAGE="$R/usr/local/libexec/chariox"
CONTEXT="$R/usr/local/share/chariox/slice-build-context"
CONTEXT_MANIFEST="$PACKAGE/slice-build-context.sha256"
AGENT="$R/Library/LaunchAgents/$LABEL.plist"
LAUNCHCTL="$R/bin/launchctl"
ADMISSION_LABEL=dev.chariox.docker-admission-locks
ADMISSION_PROGRAM="$PACKAGE/provision-docker-admission-locks.py"
ADMISSION_DAEMON="$R/Library/LaunchDaemons/$ADMISSION_LABEL.plist"

say() { printf '[chariox-pkg] %s\n' "$*"; }
die() { printf '[chariox-pkg] error: %s\n' "$*" >&2; exit 1; }
# Root runs the runtime installer: only while root owns it and every directory
# above it, and no one else can write any of them.
trusted() {
  local path=$1
  while :; do
    [ "$(stat -f %u "$path")" = 0 ] || return 1
    case "$(stat -f %Sp "$path")" in ?????w????|????????w?) return 1 ;; esac
    [ "$path" != / ] || return 0
    path=$(dirname "$path")
  done
}

if [ -z "$R" ]; then
  [ "$(id -u)" = 0 ] || die "the macOS Installer runs this as root"
  [ "${3:-/}" = / ] || die "Chariox installs only on the startup volume, not ${3:-}"
  trusted "$ADMISSION_PROGRAM" || die "$ADMISSION_PROGRAM or a directory above it is not root's alone"
  trusted "$ADMISSION_DAEMON" || die "$ADMISSION_DAEMON or a directory above it is not root's alone"
  trusted "$CONTEXT" || die "$CONTEXT or a directory above it is not root's alone"
fi
# 1. The slice build context.
[ -f "$CONTEXT_MANIFEST" ] && [ -d "$CONTEXT" ] || die "the package's slice build context is missing"
stale=$(cd "$R/" && find usr/local/share/chariox/slice-build-context ! -type d | sed 's|^|/|' | LC_ALL=C sort \
  | LC_ALL=C comm -23 - <(sed 's/^[0-9a-f]*  //' "$CONTEXT_MANIFEST" | LC_ALL=C sort))
if [ -n "$stale" ]; then
  while IFS= read -r path; do rm -f -- "$R$path"; done <<<"$stale"
  find "$CONTEXT" -type d -empty -delete
  say "removed $(wc -l <<<"$stale" | tr -d ' ') files an earlier release left in $CONTEXT"
fi

# Provision immediately: launchd's RunAtLoad is asynchronous, and /tmp is
# volatile. Never unlink or adopt a legacy user-owned lock, even on upgrade.
[ -f "$ADMISSION_PROGRAM" ] && [ ! -L "$ADMISSION_PROGRAM" ] \
  && [ -f "$ADMISSION_DAEMON" ] && [ ! -L "$ADMISSION_DAEMON" ] \
  || die "the package's Docker admission boot artifacts are missing"
/usr/bin/python3 "$ADMISSION_PROGRAM" --root "${R:-/}" \
  || die "could not provision Docker admission locks; ensure /usr/bin/python3 is available via Apple Command Line Tools; for unsafe legacy locks, stop all kernels sharing Docker before administrator repair, then reinstall; never replace a live lock"
if "$LAUNCHCTL" print "system/$ADMISSION_LABEL" >/dev/null 2>&1; then
  "$LAUNCHCTL" bootout "system/$ADMISSION_LABEL" \
    || die "could not unload the previous Docker admission daemon"
fi
"$LAUNCHCTL" enable "system/$ADMISSION_LABEL"
"$LAUNCHCTL" bootstrap system "$ADMISSION_DAEMON"

# 5. The console user's kernel. bootout stops a running kernel (launchd waits up
# to the agent's ExitTimeOut) and fails when none is loaded.
console=$(stat -f %Su "$R/dev/console" 2>/dev/null || true)
case "$console" in
  ''|root|loginwindow|_mbsetupuser)
    say "no user is logged in at the console; the kernel starts at each user's next login" ;;
  *)
    domain="gui/$(id -u "$console")"
    "$LAUNCHCTL" bootout "$domain/$LABEL" 2>/dev/null || true
    if "$LAUNCHCTL" bootstrap "$domain" "$AGENT"; then
      say "started the kernel for $console ($domain/$LABEL)"
    else
      say "warning: the kernel did not start for $console; it starts at their next login, or now with: launchctl bootstrap $domain '$AGENT'"
    fi ;;
esac

say "done: Chariox $VERSION"
