[Unit]
Description=Chariox managed kernel supervisor
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/chariox-managed-bootstrap

[Service]
Type=simple
User=chariox
Group=chariox
Environment=HOME=/home/chariox
Environment=CHARIOX_HOME=/home/chariox/.chariox
Environment=CHARIOX_MANAGED_PROVIDER_TOPOLOGY=path1
Environment=CHARIOX_TRUSTED_BUILDER_PUBLIC_KEY=/etc/chariox/boot/release-public-key
Environment=CHARIOX_MANAGED_BOOTSTRAP_PATH=/etc/chariox/bootstrap/managed-bootstrap.json
Environment=CHARIOX_MANAGED_BOOTSTRAP_RECEIPT=/var/lib/chariox/managed/bootstrap-receipt.json
Environment=CHARIOX_MANAGED_RELEASE_MANIFEST=/usr/lib/chariox/release-manifest.json
Environment=CHARIOX_MANAGED_RELEASE_SIGNATURE=/usr/lib/chariox/release-manifest.sig
Environment=CHARIOX_MANAGED_RELEASE_PUBLIC_KEY=/usr/lib/chariox/release-public-key
Environment=CHARIOX_MANAGED_KERNEL_BINARY=/usr/local/bin/chariox-kernel
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/chariox-managed-bootstrap
# Root blanks the bootstrap token in /etc/chariox/bootstrap once the control plane confirmed the enrollment. It is a
# transient unit because the supervisor cannot write that directory and Type=simple cannot wait here.
ExecStartPost=-+/usr/bin/systemd-run --quiet --no-block --collect --unit=chariox-bootstrap-grant-redeem --property=Group=chariox /usr/local/bin/chariox-managed-bootstrap --redeem-grant
Restart=on-failure
RestartSec=5
KillMode=control-group
StateDirectory=chariox
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
