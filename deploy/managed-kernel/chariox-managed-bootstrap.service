[Unit]
Description=Chariox managed independent kernel supervisor
After=network-online.target
Wants=network-online.target chariox-rootless-docker.service chariox-app-storage.service
After=chariox-rootless-docker.service chariox-app-storage.service
ConditionPathExists=/usr/local/bin/chariox-managed-bootstrap
StartLimitIntervalSec=0

[Service]
Type=simple
User=chariox
Group=chariox
SupplementaryGroups=chariox-slice
Environment=CHARIOX_APP_CGROUP_ROOT=/sys/fs/cgroup/system.slice/chariox-managed-bootstrap.service/apps
Environment=CHARIOX_HOME=/var/lib/chariox/home
Environment=HOME=/var/lib/chariox/home
Environment=CHARIOX_CAPABILITY_ISOLATION_ROOT=/var/lib/chariox/home/managed-context/kernel
Environment=CHARIOX_MANAGED_PROVIDER_ISOLATION=1
Environment=CHARIOX_MANAGED_PROVIDER_HOME=/var/lib/chariox/provider-home
Environment=CHARIOX_SLICE_ROOT=/var/lib/chariox-slice-share/slices
Environment=CHARIOX_MANAGED_VAULT_PATH=/var/lib/chariox/home/.chariox/vault/vault.json
Environment=CHARIOX_MANAGED_BOOTSTRAP_PATH=/var/lib/chariox/managed-bootstrap.json
Environment=CHARIOX_MANAGED_RELEASE_MANIFEST=/usr/lib/chariox/release-manifest.json
Environment=CHARIOX_MANAGED_RELEASE_SIGNATURE=/usr/lib/chariox/release-manifest.sig
Environment=CHARIOX_MANAGED_RELEASE_PUBLIC_KEY=/usr/lib/chariox/release-public-key
Environment=CHARIOX_MANAGED_KERNEL_BINARY=/usr/local/bin/chariox-kernel
Environment=CHARIOX_SLICE_DOCKER_BROKER_SOCKET=/var/lib/chariox-slice-share/.broker-private/control/control.sock
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=-+/usr/bin/systemctl restart chariox-slice-broker.service
ExecStartPre=+/usr/libexec/chariox-app-storage --prepare-managed-domain
ExecStart=/usr/local/bin/chariox-managed-bootstrap
Restart=always
RestartSec=2s
RestartSteps=8
RestartMaxDelaySec=5min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# bubblewrap needs to mount a fresh /proc inside each provider PID namespace.
# The unprivileged service user still cannot write host kernel tunables.
ProtectKernelTunables=false
ProtectKernelModules=true
# Kernel and its Apps own only this systemd-delegated subtree. Docker retains
# its separate unit/delegation and broker ownership. Requires systemd >=254.
ProtectControlGroups=false
Delegate=cpu memory pids
DelegateSubgroup=supervisor
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=chariox
StateDirectoryMode=0700
ReadWritePaths=/var/lib/chariox /var/lib/chariox-slice-share /var/lib/chariox-app-storage
UMask=0007

[Install]
WantedBy=multi-user.target
