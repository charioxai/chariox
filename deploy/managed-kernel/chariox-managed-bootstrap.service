[Unit]
Description=Chariox managed independent kernel supervisor
After=network-online.target
Wants=network-online.target chariox-rootless-docker.service
After=chariox-rootless-docker.service
ConditionPathExists=/usr/local/bin/chariox-managed-bootstrap
StartLimitIntervalSec=0

[Service]
Type=simple
User=chariox
Group=chariox
SupplementaryGroups=chariox-slice
# This unit is the shared-host/Docker topology. Its provider sandbox and
# service hardening are intentionally distinct from the Path-1 worker unit.
Environment=CHARIOX_MANAGED_PROVIDER_TOPOLOGY=shared_host
Environment=CHARIOX_HOME=/home/chariox/.chariox
Environment=HOME=/home/chariox
Environment=CHARIOX_CAPABILITY_ISOLATION_ROOT=/home/chariox/.chariox/managed-context/kernel
Environment=CHARIOX_MANAGED_PROVIDER_ISOLATION=1
Environment=CHARIOX_MANAGED_PROVIDER_HOME=/var/lib/chariox/provider-home
Environment=CHARIOX_MANAGED_SLICE_SERVICE_ROOT=/var/lib/chariox-slice-share
Environment=CHARIOX_MANAGED_SLICE_PUBLICATION_ROOT=/var/lib/chariox-slice-share/slices
Environment=CHARIOX_SLICE_ROOT=/var/lib/chariox-slice-share/slices
Environment=CHARIOX_MANAGED_VAULT_PATH=/home/chariox/.chariox/vault/vault.json
Environment=CHARIOX_MANAGED_BOOTSTRAP_PATH=/var/lib/chariox/managed-bootstrap.json
Environment=CHARIOX_MANAGED_BOOTSTRAP_RECEIPT=/var/lib/chariox/managed/bootstrap-receipt.json
Environment=CHARIOX_MANAGED_RELEASE_MANIFEST=/usr/lib/chariox/release-manifest.json
Environment=CHARIOX_MANAGED_RELEASE_SIGNATURE=/usr/lib/chariox/release-manifest.sig
Environment=CHARIOX_MANAGED_RELEASE_PUBLIC_KEY=/usr/lib/chariox/release-public-key
Environment=CHARIOX_MANAGED_KERNEL_BINARY=/usr/local/bin/chariox-kernel
Environment=CHARIOX_SLICE_DOCKER_BROKER_SOCKET=/var/lib/chariox-slice-share/.broker-private/control/control.sock
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=-+/usr/bin/systemctl restart chariox-slice-broker.service
ExecStart=/usr/local/bin/chariox-managed-bootstrap
Restart=always
RestartSec=2s
RestartSteps=8
RestartMaxDelaySec=5min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# bubblewrap needs to mount a fresh /proc inside each provider PID namespace.
# The unprivileged service user still cannot write host kernel tunables.
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=chariox
StateDirectoryMode=0700
ReadWritePaths=/home/chariox /var/lib/chariox /var/lib/chariox-slice-share
UMask=0007

[Install]
WantedBy=multi-user.target
