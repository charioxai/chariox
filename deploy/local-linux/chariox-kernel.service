# The local Chariox kernel, a systemd --user unit of its ordinary owner.
# install-user.sh installs it; install-root.sh enrolled this unit's `apps`
# child as the owner's App cgroup root.
[Unit]
Description=Chariox kernel

[Service]
Type=simple
Environment=CHARIOX_HOME=%h/.chariox
Environment=CHARIOX_LOG_DIR=%h/.chariox/logs
Environment=CHARIOX_KERNEL_HOST=127.0.0.1
EnvironmentFile=-%h/.config/chariox/kernel.env
# The kernel and its Apps own only this unit's delegated subtree.
Delegate=cpu memory pids
DelegateSubgroup=supervisor
# Prepares the `apps` subtree from the supervisor subgroup, then execs the
# kernel. No ExecStartPre/Post: see start-kernel.sh.
ExecStart=%h/.local/lib/chariox/start-kernel.sh %h/.local/bin/chariox-kernel
KillMode=control-group
TimeoutStopSec=60s

[Install]
WantedBy=default.target
