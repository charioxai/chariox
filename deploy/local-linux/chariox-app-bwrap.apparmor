# Chariox App runtime: Ubuntu 23.10 and later refuse unprivileged user
# namespaces to unconfined programs. This lets only the bubblewrap bundled in an
# installed, signed App runtime generation create them, so it can build each App
# worker's sandbox. Those directories are root-owned and read-only; nothing else
# is confined or granted. Installed by install-root.sh.
abi <abi/4.0>,
include <tunables/global>

profile chariox-app-bwrap /usr/lib/chariox/app-runtimes/[0-9a-f]*/chariox-bwrap flags=(unconfined) {
  userns,
}
