# Chariox App runtime and kernel browser: Ubuntu 23.10 and later refuse unprivileged user
# namespaces to unconfined programs. This lets only trusted native entries and bubblewrap in an
# installed, signed App runtime generation create them, so it can build each App
# worker's sandbox. Those directories are root-owned and read-only; nothing else
# is confined or granted. Installed by install-root.sh.
abi <abi/4.0>,
include <tunables/global>

profile chariox-browser-unshare /usr/lib/chariox/browser/chariox-browser-unshare flags=(unconfined) {
  userns,
}

# The pinned kernel Chromium (kernel-browser-chromium.lock.json), installed read-only
# by install-root.sh, keeps its own namespace sandbox.
profile chariox-browser-chromium /usr/lib/chariox/browser/chromium/*/chrome-linux64/chrome flags=(unconfined) {
  userns,
}
