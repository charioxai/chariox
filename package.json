{
  "name": "arroba",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:cli": "pnpm --filter @arroba/cli run build",
    "lint": "pnpm -r run lint",
    "start:cli": "pnpm --filter @arroba/cli run start",
    "test": "pnpm -r run test",
    "test:daemon": "cargo test --manifest-path apps/daemon/Cargo.toml",
    "smoke:daemon": "cargo run --manifest-path apps/daemon/Cargo.toml --bin arroba-daemon-harness"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1"
  }
}
