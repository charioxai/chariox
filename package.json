{
  "name": "chariox",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "start:kernel": "node scripts/start-kernel.mjs",
    "package:managed-kernel-release": "node scripts/package-managed-kernel-release.mjs",
    "build:kernel-client": "node scripts/generate-protocol-versions.mjs --check && pnpm --filter @chariox/tool-display run build && pnpm --filter @chariox/kernel-client run build",
    "build:cli": "pnpm --filter @chariox/cli run build",
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "start:cli": "node scripts/start-cli.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm run test:review-regressions && pnpm run test:slice-provisioner && pnpm -r --workspace-concurrency=1 run test",
    "lint:process-signals": "node scripts/lint-process-signals.mjs",
    "test:process-signals": "node --test scripts/lint-process-signals.test.mjs scripts/owned-process-signals.test.mjs scripts/owned-process-signals-python.test.mjs",
    "test:slice-provisioner": "sh -c 'for file in apps/kernel/slice-linux-docker/provision-*.test.mjs apps/kernel/slice-linux-docker/slice-disk-quota*.test.mjs apps/kernel/slice-linux-docker/managed-rootless-quota*.test.mjs apps/kernel/slice-linux-docker/slice-screen-*.test.mjs apps/kernel/slice-linux-docker/chariox-data-volume-admission.test.mjs; do [ -f \"$file\" ] || exit 1; done; exec node --test --test-concurrency=1 apps/kernel/slice-linux-docker/provision-*.test.mjs apps/kernel/slice-linux-docker/slice-disk-quota*.test.mjs apps/kernel/slice-linux-docker/managed-rootless-quota*.test.mjs apps/kernel/slice-linux-docker/slice-screen-*.test.mjs apps/kernel/slice-linux-docker/chariox-data-volume-admission.test.mjs'",
    "test:daemon": "RUST_MIN_STACK=16777216 RUST_TEST_THREADS=1 cargo test --manifest-path apps/kernel/Cargo.toml",
    "test:browser-controller-browser": "node --test --test-concurrency=1 apps/kernel/slice-linux-docker/docker/browser-controller.browser-test.mjs",
    "perf:drills": "node scripts/performance-drills.mjs",
    "validation:suite": "node apps/cli/scripts/drill-validation-suite.mjs",
    "validation:focused-runtime-gate": "pnpm --filter @chariox/cli run validation:focused-runtime-gate",
    "validation:distributed-runtime-gate": "pnpm --filter @chariox/cli run validation:distributed-runtime-gate",
    "protocol:conformance": "cargo test --manifest-path apps/kernel/Cargo.toml client_protocol_conformance -- --nocapture",
    "smoke:daemon": "cargo run --manifest-path apps/kernel/Cargo.toml --bin chariox-kernel-harness",
    "start:shell": "pnpm --filter @chariox/shell run start",
    "test:review-regressions": "node --test --test-concurrency=1 deploy/managed-kernel/managed-update-recovery.test.mjs apps/kernel/managed-upgrade-protocol-transitions.test.mjs apps/cli/scripts/lib/drill-turn-admission.test.mjs apps/cli/scripts/lib/native-permission-workspace.test.mjs",
    "protocol:generate": "node scripts/generate-protocol-versions.mjs",
    "protocol:check": "node scripts/generate-protocol-versions.mjs --check"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "@opentui/core@0.1.87": "patches/@opentui__core@0.1.87.patch"
    },
    "overrides": {
      "@opentui/core-darwin-x64": "0.1.88",
      "@opentui/core-darwin-arm64": "0.1.88",
      "@opentui/core-linux-x64": "0.1.88",
      "@opentui/core-linux-arm64": "0.1.88",
      "@opentui/core-win32-x64": "0.1.88",
      "@opentui/core-win32-arm64": "0.1.88"
    }
  }
}
