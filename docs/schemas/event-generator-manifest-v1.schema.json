{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chariox.com/schemas/event-generator-manifest-v1.schema.json",
  "title": "Chariox Event Generator Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_id", "version", "name", "publisher", "protocol_version", "events", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "generator_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 1000 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
    "publisher": { "$ref": "#/$defs/party" },
    "protocol_version": { "const": 3 },
    "categories": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "authorization": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "disclosure"],
      "properties": {
        "kind": { "enum": ["oauth2", "app_installation", "api_token", "none"] },
        "disclosure": { "type": "string", "minLength": 1 }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/event" }
    },
    "signature": { "$ref": "#/$defs/signature" },
    "deprecation": { "type": ["object", "null"] }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "version", "name", "filter_schema"],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "filter_schema": { "type": "object" },
        "required_scopes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "digest", "value"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "ed25519" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
