{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arroba.dev/schemas/aegs-resource-query-v1.schema.json",
  "title": "Arroba AEGS Provider Resource Query",
  "type": "object",
  "additionalProperties": false,
  "required": ["generator_id", "connection_id", "limit"],
  "properties": {
    "generator_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "connection_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "query": { "type": ["string", "null"], "maxLength": 512 },
    "cursor": { "type": ["string", "null"], "maxLength": 2048 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
  }
}
